#
# X86_64 · ImmortalWrt (openwrt-25.12 分支) 编译配置
# 版本标识 25.12.2 · 默认 IPv4 单栈 · 双主题 + 指定插件集
# 说明：这里只写"关键开关"，其余由 make defconfig 自动补全
#
# ==== Target: x86_64 (Generic) ====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
# ==== 镜像分区容量 ====
# x86 默认 ROOTFS 分区 448MiB，装 Docker/containerd 以及
# passwall2/clashoo/xray 等内核后体积会超过该值，镜像阶段报
#   ext4_allocate_best_fit_partial: failed to allocate N blocks, out of space?
# 这里显式放大到 1024MiB（用户要求 1G），Kernel 分区保持 64MiB。
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# 2026-11-13 移除 ccache：三轮实测命中率 1/24（4%），且恢复的 dl 缓存里 go-mod-cache 残缺，
# 直接导致 clashoo(mihomo) 编译报 "no required module provides package"，属净损失，故关闭。
# CONFIG_CCACHE is not set
# ==== IPv4 单栈 ====
# 内核 CONFIG_IPV6 必须保持 y（ImmortalWrt 的 config/Config-build.in 里是
# `config IPV6 / def_bool y` 强制符号；nftables 的 kmod 在 FILES 里引用了
# net/ipv6/netfilter/*.ko，关掉内核 IPv6 会导致打包阶段报 module is missing）。
# 真正的"默认网络是 IPv4"由 diy-part2.sh 在运行时实现：
#   - config_generate 不再生成 wan6 / ip6assign / IPv6 DNS
#   - /etc/sysctl.conf + /etc/sysctl.d/99-ipv4-only.conf 全局 disable_ipv6
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_6in4 is not set
# CONFIG_PACKAGE_6to4 is not set
# ==== LuCI 基础 ====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_LUCI_LANG_zh_Hans=y
# ==== 主题：Argon（默认）+ Vantage + Aurora ====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-theme-aurora=y
# CONFIG_PACKAGE_luci-app-vantage is not set
# ==== 用户指定插件 · 第一组 ====
CONFIG_PACKAGE_luci-app-run=y
# ==== Quickfile（已移除） ====
# 2026-11-13 移除：quickfile 是 Rust/Axum 写的，其 Makefile 声明 PKG_BUILD_DEPENDS:=rust/host，
# 会把 feeds/packages/lang/rust 1.96.0 的 host 编译拉进构建计划，而该包要从 ci 拉预编译 LLVM
# （https://ci-artifacts.rust-lang.org/... 已 404），固定在 2h30m 处失败（run #5 / #7 实证）。
# 上游 sbwml/luci-app-quickfile 没有预编译 release 二进制，无法改成"下载即用"，
# 故整体移除；文件管理改用 dockerman/diskman 自带的文件浏览能力。
# CONFIG_PACKAGE_luci-app-quickfile is not set
# CONFIG_PACKAGE_quickfile is not set

# ==== Shadowsocks 的 Rust 实现（已关闭） ====
# 2026-11-13：run #8 实证，make download 阶段出现 feeds/packages/net/shadowsocks-rust，
# 说明它被 defconfig 以 =m 选中（我原先的校验只查 =y 因此漏掉）。它同样声明 rust/host，
# 是 quickfile 之后第二个把 host rustc 拉进构建的包，最终在 1h43m 处失败：
#   make[3]: *** [.../host/rustc-1.96.0-src/.built] Error 1
#   ERROR: package/feeds/packages/lang/rust [host] failed to build
# passwall2 的代理核心用 xray-core 已够，不需要 Rust 版 SS，故显式关闭。
# CONFIG_PACKAGE_shadowsocks-rust is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# 2026-11-13 run #9 的 Verify 抓到真凶：luci-app-passwall 的两个 INCLUDE 默认就是 y，
# 直接把 shadowsocks-rust（Rust 实现）拉进构建 → 触发 host rustc → ci-llvm 404 失败。
#   CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
#   CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=y
# 这里显式关掉；代理核心由 xray-core（Go）承担，不依赖 Rust 版 SS。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
CONFIG_PACKAGE_luci-app-partexp=y
# ==== PassWall2 ====
# 源码来自 Openwrt-Passwall/openwrt-passwall2（见 diy-part1.sh）
# 只编 Xray 内核，避免 Basic_Core_All 把 sing-box/hysteria 一起拉进来
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# ==== SSR Plus（已移除） ====
# 2026-11-12 起不再编译 ssr-plus：它是整条链路里唯一牵扯 rust 生态的应用，
# 而 feeds/packages/lang/rust 1.96.0 要从 ci 拉预编译 LLVM，该链接已 404，
# 每轮都在 2h44m 处崩在 rustc host 编译上（见 run #4 日志）。
# 代理能力由 passwall2（Xray 内核）覆盖，不再需要 ssr-plus。
# 注意：写成 "# ... is not set" 是必须的，因为 defconfig 会补齐所有可见符号，
# 只删掉 =y 那一行并不能保证它不被默认选回来。
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# ==== Clashoo ====
# 源码来自 kenzok8/openwrt-clashoo（见 diy-part1.sh）
# clashoo 的 DEPENDS 在 ImmortalWrt 的 metadata 里能完整解析，但运行时用到的工具
# （yq/unzip/nohup/timeout/ip-full/nft 相关 kmod）不一定被默认选中，这里显式选上
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_luci-app-clashoo=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
# ==== Docker ====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_ttyd=y
# ==== DiskMan ====
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
# ==== 常用基础组件 ====
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-tun=y

#
# 家庭 / 运维工具（补充）
#
# SQM 流量整形
CONFIG_PACKAGE_luci-app-sqm=y
# 动态域名
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
# 流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
# WireGuard 协议
CONFIG_PACKAGE_luci-proto-wireguard=y
# UPnP 端口映射
CONFIG_PACKAGE_luci-app-upnp=y
# 命令面板
CONFIG_PACKAGE_luci-app-commands=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# Docker Compose
CONFIG_PACKAGE_docker-compose=y
