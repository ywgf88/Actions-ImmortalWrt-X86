#
# X86_64 · ImmortalWrt (openwrt-25.12 分支) 编译配置
# 版本标识 25.12.2 · 默认 IPv4 单栈 · 双主题 + 指定插件集
# 说明：这里只写"关键开关"，其余由 make defconfig 自动补全
#
# ==== Target: x86_64 (Generic) ====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
# ==== 镜像分区容量 ====
# x86 默认 ROOTFS 分区 448MiB，装 Docker/containerd 以及
# passwall2/clashoo/xray 等内核后体积会超过该值，镜像阶段报
#   ext4_allocate_best_fit_partial: failed to allocate N blocks, out of space?
# 这里显式放大到 1024MiB（用户要求 1G），Kernel 分区保持 64MiB。
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# 编译缓存：ccache 让第二次起跳过重复的 C/C++ 编译（路径固定为 /workdir/openwrt/.ccache 才能命中）
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/workdir/openwrt/.ccache"
# ==== IPv4 单栈 ====
# 内核 CONFIG_IPV6 必须保持 y（ImmortalWrt 的 config/Config-build.in 里是
# `config IPV6 / def_bool y` 强制符号；nftables 的 kmod 在 FILES 里引用了
# net/ipv6/netfilter/*.ko，关掉内核 IPv6 会导致打包阶段报 module is missing）。
# 真正的"默认网络是 IPv4"由 diy-part2.sh 在运行时实现：
#   - config_generate 不再生成 wan6 / ip6assign / IPv6 DNS
#   - /etc/sysctl.conf + /etc/sysctl.d/99-ipv4-only.conf 全局 disable_ipv6
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_6in4 is not set
# CONFIG_PACKAGE_6to4 is not set
# ==== LuCI 基础 ====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_LUCI_LANG_zh_Hans=y
# ==== 主题：Argon（默认）+ Vantage + Aurora ====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-theme-aurora=y
# CONFIG_PACKAGE_luci-app-vantage is not set
# ==== 用户指定插件 · 第一组 ====
CONFIG_PACKAGE_luci-app-run=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_quickfile=y
CONFIG_PACKAGE_luci-app-partexp=y
# ==== PassWall2 ====
# 源码来自 Openwrt-Passwall/openwrt-passwall2（见 diy-part1.sh）
# 只编 Xray 内核，避免 Basic_Core_All 把 sing-box/hysteria 一起拉进来
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# ==== SSR Plus（ssrp） ====
# 源码来自 fw876/helloworld（见 diy-part1.sh）
CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
# SS 客户端是 kconfig 的 choice（单选组），x86_64 上的 default 就是 Shadowsocks-rust。
# 所以写 "# ... is not set" 无效，defconfig 会按 default 把它选回来（#3 因此在 6 分钟被 Verify 拦下）。
# 正确做法是显式选中组里的 None；代理协议用 Xray + ShadowSocksR-libev 已足够覆盖。
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client=y
# ImmortalWrt 25.12 的 feeds 已不再提供 shadowsocks-libev 分体包（ss-local/ss-redir/ss-server），
# 所以把 Shadowsocks-libev 的客户端/服务端选项显式关掉，只保留 ShadowSocksR-libev 与 Xray
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server is not set
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server=y
# ==== Clashoo ====
# 源码来自 kenzok8/openwrt-clashoo（见 diy-part1.sh）
# clashoo 的 DEPENDS 在 ImmortalWrt 的 metadata 里能完整解析，但运行时用到的工具
# （yq/unzip/nohup/timeout/ip-full/nft 相关 kmod）不一定被默认选中，这里显式选上
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_luci-app-clashoo=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
# ==== Docker ====
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_ttyd=y
# ==== DiskMan ====
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
# ==== 常用基础组件 ====
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-tun=y

#
# 家庭 / 运维工具（补充）
#
# SQM 流量整形
CONFIG_PACKAGE_luci-app-sqm=y
# 动态域名
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
# 流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
# WireGuard 协议
CONFIG_PACKAGE_luci-proto-wireguard=y
# UPnP 端口映射
CONFIG_PACKAGE_luci-app-upnp=y
# 命令面板
CONFIG_PACKAGE_luci-app-commands=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# Docker Compose
CONFIG_PACKAGE_docker-compose=y
